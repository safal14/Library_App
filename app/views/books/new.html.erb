<h1 class="text-center mt-4 mb-5">Add a New Book</h1>

<%= form_with model: @book do |form| %>

  <!-- Title field -->
  <div class="mb-3"> <!-- mb-3 = margin bottom for spacing -->
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :author, class: "form-label" %>
    <%= form.text_field :author, class: "form-control" %>
  </div>

  <div class="mb-4">
    <%= form.label :rating, class: "form-label" %>
    <%= form.number_field :rating, class: "form-control", min: 1, max: 5 %>
  </div>

  <div class="mb-4">
    <%= form.submit "Add Book", class: "btn btn-success btn-lg" %>
  </div>

<% end %>

<div class="text-center">
  <%= link_to "← Back to Library", books_path, class: "btn btn-outline-primary" %>
</div>