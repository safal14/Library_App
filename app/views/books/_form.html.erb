<%= form_with model: book, local: true do |form| %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control form-control-lg", placeholder: "Enter book title" %>
  </div>

  <div class="mb-3">
    <%= form.label :author, class: "form-label" %>
    <%= form.text_field :author, class: "form-control form-control-lg", placeholder: "Enter author name" %>
  </div>

  <div class="mb-4">
    <%= form.label :rating, class: "form-label" %>
    <%= form.number_field :rating, in: 1..5, class: "form-control form-control-lg", placeholder: "1 to 5" %>
  </div>

  <div class="d-grid gap-3 d-md-flex justify-content-md-start">
    <%= form.submit submit_text, class: "btn btn-success btn-lg px-5" %>
    <%= link_to "Cancel", books_path, class: "btn btn-outline-secondary btn-lg px-5" %>
  </div>

<% end %>