<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Basic head section: Title, viewport for mobile, security tags -->
    <title><%= content_for(:title) || "Library App" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>  <!-- Rails security for forms -->
    <%= csp_meta_tag %>     <!-- Rails security for content -->

    <!-- Bootstrap CSS: Makes things look pretty and responsive -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
          rel="stylesheet" 
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" 
          crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <!-- Your app's stylesheets and JavaScript -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <!-- Simple Navigation Bar: Fixed at top, collapses on mobile -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container-fluid">
        <!-- Brand link: Goes to books list -->
        <a class="navbar-brand" href="<%= books_path %>">📚 Library App</a>
        
        <!-- Mobile menu button (hides/shows links on small screens) -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        
        <!-- Menu links -->
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <%= link_to "All Books", books_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Add New Book", new_book_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
            <%= link_to "History", rentals_history_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
            <%= link_to "Checkout Books", checkout_path, class: "nav-link" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Main content area: Where page content (like books list) goes -->
    <main class="container my-5">
    <% flash.each do |type, message| %>
    <% next unless message.present? %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
      <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>
      <%= yield %>  <!-- This inserts the content from your views (index, new, show, etc.) -->
    </main>
    <footer class="bg-dark text-white py-4 mt-auto">
      <div class="container text-center">
        <p class="mb-1">&copy; <%= Time.now.year %> Library App. All rights reserved.</p>
        <small class="text-muted">Built with Ruby on Rails & Bootstrap</small>
      </div>
    </footer>
  </body>
</html>